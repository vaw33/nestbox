peak_times <- lag_plot_data %>%
  mutate(clean_date = as_date(date_time)) %>%
  group_by(id, clean_date) %>%
  # Find the row with the maximum temperature for that specific day
  slice_max(temp_C, n = 1, with_ties = FALSE) %>%
  ungroup() %>%
  mutate(
    # Convert the time of day into a decimal number (e.g., 14.5 for 2:30 PM)
    time_in_hours = hour(date_time) + minute(date_time)/60
  ) %>%
  group_by(id) %>%
  summarize(
    mean_hour = mean(time_in_hours),
    # Convert that decimal back into a clean HH:MM clock format
    avg_peak_time = sprintf("%02d:%02d", floor(mean_hour), round((mean_hour - floor(mean_hour)) * 60)),
    .groups = "drop"
  ) %>%
  select(id, avg_peak_time)

