# 1. Load and format the continuous 15-min ambient data
ambient_continuous <- read_csv("temp_data_apr22_apr24.csv") %>%
  mutate(
    # FIX: Use parse_date_time to safely catch AM/PM formats or hidden seconds
    date_time = parse_date_time(paste(date, time), orders = c("mdy IMp", "mdy HMS", "mdy HM")),
    temp_C = (temp - 32) * (5/9),
    id = "Ambient Air"
  ) %>%
  # Explicitly call dplyr::select to prevent background masking errors
  dplyr::select(id, date_time, temp_C) %>%
  drop_na(temp_C)

# 2. Extract and prep the 15-min iButton data for those same 3 days
cavity_continuous <- data_prepped %>%
  filter(date %in% as_date(c("2023-04-22", "2023-04-23", "2023-04-24"))) %>%
  mutate(
    base_id = str_remove(id, "-.*"),
    id = ifelse(str_detect(base_id, "SAG"), id, paste0(base_id, "_avg"))
  ) %>%
