library(tidyverse)
library(lubridate)

# 1. Load the dataset
setwd("/Users/victoriawiley/Library/CloudStorage/Dropbox/Documents/_PhD/Manuscripts/6_Nestbox/data") 
all_data <- read_csv("tempdata_alldata_15min.csv")

# 2. Calculate the grand mean for specific time blocks in Celsius
grand_time_summary_C <- all_data %>%
  mutate(
    # Combine date and time to extract the exact hour
    date_time = parse_date_time(paste(date, time), orders = c("mdy IMp", "mdy HMS", "mdy HM")),
    hr = hour(date_time),
    
    # Label the rows that fall into the target windows
    time_block = case_when(
      hr >= 4 & hr < 7   ~ "4:00 AM to 6:59 AM",
      hr >= 13 & hr < 16 ~ "1:00 PM to 3:59 PM",
      TRUE               ~ "Other"
    ),
    
    # Convert Fahrenheit to Celsius
    temp_C = (temp - 32) * (5/9)
  ) %>%
  # Filter out times of day outside our target blocks
  filter(time_block != "Other") %>%
  
  # Group ONLY by the time block so all dates are averaged together
  group_by(time_block) %>%
  summarize(
    overall_mean_temp_C = round(mean(temp_C, na.rm = TRUE), 2),
    .groups = "drop"
  )

# 3. View the final overall averages
print(grand_time_summary_C)

