# ==========================================
# STEP 6: PUBLICATION TABLE (WITH SIG LETTERS)
# ==========================================
final_data_metric <- daily_averaged %>% 
  left_join(ambient_clean, by = "date") %>% 
  mutate( 
    max_temp_C = (max_temp - 32) * (5/9), 
    min_temp_C = (min_temp - 32) * (5/9), 
    max_ambient_C = (max_ambient - 32) * (5/9), 
    min_ambient_C = (min_ambient - 32) * (5/9) 
  ) %>% 
  mutate( 
    delta_ambient_high_C = max_temp_C - max_ambient_C, 
    delta_ambient_low_C = min_temp_C - min_ambient_C, 
    range_difference_C = (max_ambient_C - min_ambient_C) - (max_temp_C - min_temp_C) 
  ) %>% 
  drop_na() 

publication_table <- final_data_metric %>% 
  group_by(id) %>% 
  summarize( 
    mean_high_C = mean(delta_ambient_high_C), 
    sd_high_C = sd(delta_ambient_high_C), 
    mean_low_C = mean(delta_ambient_low_C), 
    sd_low_C = sd(delta_ambient_low_C), 
    mean_buf_C = mean(range_difference_C), 
    sd_buf_C = sd(range_difference_C), 
    .groups = "drop" 
  ) %>% 
  transmute( 
    Cavity_Name = factor(id,  
                         levels = c("G_avg", "GC_avg", "LH_avg", "GK_avg", "TB_avg", "SAG1", "SAG2"), 
                         labels = c("Plastic Gourd", "Design 1", "Design 2", "Design 3", "Wood Box", "Saguaro 1", "Saguaro 2")), 
    
    Daily_Max_Delta = case_when( 
      id %in% c("SAG1", "SAG2") ~ paste0(round(mean_high_C, 1), " ± ", round(sd_high_C, 1), " a"), 
      id == "GC_avg"            ~ paste0(round(mean_high_C, 1), " ± ", round(sd_high_C, 1), " b"), 
      id == "GK_avg"            ~ paste0(round(mean_high_C, 1), " ± ", round(sd_high_C, 1), " c"), 
      id == "TB_avg"            ~ paste0(round(mean_high_C, 1), " ± ", round(sd_high_C, 1), " cd"), 
      id == "LH_avg"            ~ paste0(round(mean_high_C, 1), " ± ", round(sd_high_C, 1), " de"), 
      id == "G_avg"             ~ paste0(round(mean_high_C, 1), " ± ", round(sd_high_C, 1), " e") 
    ), 
    
    Daily_Min_Delta = case_when( 
      id %in% c("SAG1", "SAG2")             ~ paste0(round(mean_low_C, 1), " ± ", round(sd_low_C, 1), " a"), 
      id == "GC_avg"                        ~ paste0(round(mean_low_C, 1), " ± ", round(sd_low_C, 1), " b"),
      id == "LH_avg"                        ~ paste0(round(mean_low_C, 1), " ± ", round(sd_low_C, 1), " bc"),
      id %in% c("GK_avg", "TB_avg", "G_avg")~ paste0(round(mean_low_C, 1), " ± ", round(sd_low_C, 1), " c") 
    ), 
    
    Buffering_Capacity = case_when( 
      id %in% c("SAG1", "SAG2") ~ paste0(round(mean_buf_C, 1), " ± ", round(sd_buf_C, 1), " a"), 
      id == "GC_avg"            ~ paste0(round(mean_buf_C, 1), " ± ", round(sd_buf_C, 1), " b"), 
      id %in% c("GK_avg", "TB_avg") ~ paste0(round(mean_buf_C, 1), " ± ", round(sd_buf_C, 1), " c"), 
      id == "LH_avg"            ~ paste0(round(mean_buf_C, 1), " ± ", round(sd_buf_C, 1), " cd"), 
      id == "G_avg"             ~ paste0(round(mean_buf_C, 1), " ± ", round(sd_buf_C, 1), " d") 
    ) 
  ) %>% 
  arrange(Cavity_Name) 

View(publication_table) 
write_csv(publication_table, "Table1_Thermal_Summary_C.csv")

