  group_by(id, date_time) %>%
  summarize(temp = mean(temp, na.rm = TRUE), .groups = "drop") %>%
  mutate(temp_C = (temp - 32) * (5/9)) %>%
  # FIX: Explicitly call dplyr::select to prevent masking errors
